/* ============================================================================
   在网页上与曳尔沐聊天 · elymes-nte-web
   ----------------------------------------------------------------------------
   这个文件是"皮肤"：把 Coopanion WebUI 重绘成图一那样的 Windows 98 桌面 +
   QQ2007 聊天窗。所有规则都挂在 `html.mln-on` 下，卸载/关闭后不残留。

   分工：
     body::before / body::after  桌面：天空、云、草地、黄花
     #rail                       左侧桌面图标条（原导航）
     #kernel-root                窗口本体（立体边框 + 浅紫底）
     .mln-chrome                 标题栏 + 菜单栏（JS 注入）
     .mln-portrait               右侧立绘（JS 注入，仅聊天页）
     .mln-emobar                 底部表情/任务栏（JS 注入）
     .mln-panel-*                插件设置面板（世界与插件页）

   字体：assets/fonts/FusionPixel.woff2 由用户放入；缺失时回退系统等宽字体。
   ========================================================================= */

@font-face {
  font-family: 'Fusion Pixel';
  src: local('Fusion Pixel 12px'), local('FusionPixel12'),
       url('../assets/fonts/FusionPixel.woff2') format('woff2'),
       url('../assets/fonts/FusionPixel.ttf') format('truetype');
  font-display: swap;
}

html.mln-on {
  --mln-face: 'Poxiao Pixel CN 12', 'Fusion Pixel', 'MS Sans Serif', 'Tahoma', 'SimSun', '宋体', monospace;
  --mln-w: 26px;              /* 标题栏高 */
  --mln-m: 22px;              /* 菜单栏高 */
  --mln-chrome-h: 48px;       /* 两者合计 */
  --mln-barh: 28px;           /* 底部表情条高 */

  --mln-win: #d8d6ef;
  --mln-win-2: #ebe9fb;
  --mln-edge-lt: #fbfaff;
  --mln-edge-md: #ffffff;
  --mln-edge-dk: #6f6f9c;
  --mln-edge-xdk: #3d3d66;
  --mln-ink: #22223e;
  --mln-ink-soft: #4b4b72;
  --mln-title-a: #8b8adb;
  --mln-title-b: #bcbaf0;
  --mln-menu-ink: #1c2f79;
  --mln-portrait-w: clamp(260px, 34vw, 460px);
}

/* ---------------------------------------------------------------- 桌面背景 */
html.mln-on,
/* 桌面只留纯色底，不铺任何背景图；要看的是那个窗口本身。 */
html.mln-on body {
  background-color: #23283c;
  font-family: var(--mln-face);
  image-rendering: pixelated;
}

/* 桌面上的图标条：把原导航改成 Win98 图标列 */
html.mln-on #rail {
  width: 92px;
  background: transparent;
  border: 0;
  padding: 12px 4px 12px;
  color: #fff;
  font-family: var(--mln-face);
  text-shadow: 1px 1px 0 #00133a, 2px 2px 0 rgba(0, 0, 0, .35);
  z-index: 3;
}

html.mln-on #rail .brand {
  color: #fff;
  filter: drop-shadow(1px 1px 0 #00133a);
  margin-bottom: 10px;
  opacity: .92;
}

html.mln-on #rail .stack {
  gap: 4px;
}

html.mln-on #rail .stack > * {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2px;
  padding: 6px 2px;
  min-height: 52px;
  border: 1px solid transparent;
  border-radius: 0;
  background: transparent;
  color: #fff;
  font-family: var(--mln-face);
  font-size: 11px;
  line-height: 1.25;
  text-align: center;
  text-shadow: inherit;
}

html.mln-on #rail .stack > *:hover,
html.mln-on #rail .stack > *[aria-current='page'],
html.mln-on #rail .stack > *.active {
  background: rgba(255, 255, 255, .18);
  border: 1px dotted #fff;
}

html.mln-on #rail .railfoot {
  color: #fff;
  border-top: 1px solid rgba(255, 255, 255, .28);
  padding-top: 8px;
}

html.mln-on #rail .rail-name,
html.mln-on #rail .rail-runstate {
  color: #fff;
  font-size: 11px;
}

html.mln-on #rail .rail-action {
  background: linear-gradient(#e6e4f8, #b9b7dd);
  border: 1px solid #fff;
  box-shadow: inset -1px -1px 0 #5d5d8a, inset 1px 1px 0 #fff;
  color: #22223e;
}

/* ---------------------------------------------------------------- 窗口本体 */
html.mln-on #kernel-root {
  position: relative;
  z-index: 1;
  box-sizing: border-box;
  max-height: calc(100vh - 16px);
  overflow: hidden;
  margin: 8px 12px 8px 6px;
  padding: var(--mln-chrome-h) 0 0 0;
  background: var(--mln-win);
  color: var(--mln-ink);
  font-family: var(--mln-face);
  font-size: 12px;
  border: 1px solid var(--mln-edge-xdk);
  box-shadow:
    inset 1px 1px 0 var(--mln-edge-md),
    inset -1px -1px 0 var(--mln-edge-dk),
    inset 2px 2px 0 var(--mln-edge-lt),
    inset -2px -2px 0 #8585b0,
    4px 4px 0 rgba(0, 0, 0, .35);
}

/* 窗口内部一律换成杂志纸底色，压掉宿主的深色卡片 */
html.mln-on #kernel-root,
html.mln-on #kernel-root .sheet,
html.mln-on #kernel-root .page,
html.mln-on #kernel-root .card {
  background-color: var(--mln-win-2);
}

html.mln-on #kernel-root :focus-visible {
  outline: 1px dotted var(--mln-ink);
  outline-offset: 1px;
}

/* ------------------------------------------------------- 标题栏 + 菜单栏 */
.mln-chrome {
  position: absolute;
  inset: 0 0 auto 0;
  height: var(--mln-chrome-h);
  z-index: 6;
  font-family: var(--mln-face);
  user-select: none;
}

.mln-titlebar {
  display: flex;
  align-items: center;
  gap: 5px;
  height: var(--mln-w);
  padding: 0 2px 0 4px;
  color: #fff;
  font-size: 12px;
  letter-spacing: .2px;
  text-shadow: 1px 1px 0 rgba(20, 20, 60, .8);
  background: linear-gradient(180deg, #a7a5e6 0%, #9694dd 18%, #7f7dd0 52%, #8f8dd8 88%, #b3b1ec 100%);
  border-bottom: 1px solid #5a588f;
}

.mln-titlebar[data-kind='active'] {
  background: linear-gradient(180deg, #b9b7f0 0%, #a3a1e4 18%, #8b89d6 52%, #9b99dd 88%, #c0bef1 100%);
}

.mln-tb-icon {
  width: 14px;
  height: 14px;
  flex: none;
  border: 1px solid #4a4880;
  background:
    linear-gradient(#7fd4ff, #2b7fd4) padding-box;
  box-shadow: inset 1px 1px 0 rgba(255, 255, 255, .8);
}

.mln-tb-text {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-weight: 700;
}

.mln-tb-btns {
  display: flex;
  gap: 2px;
  flex: none;
}

.mln-tb-btn {
  width: 18px;
  height: 16px;
  padding: 0;
  display: grid;
  place-items: center;
  background: linear-gradient(#fdfdff, #cfcde8);
  border: 1px solid #fff;
  box-shadow: inset -1px -1px 0 #6d6b9c, inset 1px 1px 0 #fff, 0 0 0 1px #4a4880;
  color: #1d1d3a;
  cursor: pointer;
  font-family: var(--mln-face);
  font-size: 10px;
  line-height: 1;
}

.mln-tb-btn:hover {
  background: linear-gradient(#fff, #e2e0f6);
}

.mln-tb-btn:active {
  box-shadow: inset 1px 1px 0 #6d6b9c, inset -1px -1px 0 #fff, 0 0 0 1px #4a4880;
}

/* 三个图标：最小化 / 最大化 / 关闭，全用伪元素画，像素对齐 */
.mln-tb-min::before {
  content: '';
  width: 8px;
  height: 2px;
  background: #1d1d3a;
  transform: translateY(4px);
}

.mln-tb-max::before {
  content: '';
  width: 8px;
  height: 7px;
  border: 1px solid #1d1d3a;
  border-top-width: 2px;
}

.mln-tb-close {
  margin-left: 2px;
}

.mln-tb-close::before,
.mln-tb-close::after {
  content: '';
  position: absolute;
  width: 9px;
  height: 1.5px;
  background: #1d1d3a;
}

.mln-tb-close {
  position: relative;
}

.mln-tb-close::before {
  transform: rotate(45deg);
}

.mln-tb-close::after {
  transform: rotate(-45deg);
}

/* 菜单栏 */
.mln-menubar {
  display: flex;
  align-items: stretch;
  height: var(--mln-m);
  padding: 0 2px;
  background: linear-gradient(#f4f2ff, #e3e0f6);
  border-bottom: 1px solid #a9a7cc;
  box-shadow: inset 0 -1px 0 #fff;
  position: relative;
}

.mln-menu {
  position: relative;
}

.mln-menu > button {
  height: 100%;
  padding: 0 9px;
  border: 1px solid transparent;
  background: transparent;
  color: var(--mln-menu-ink);
  font-family: var(--mln-face);
  font-size: 12px;
  cursor: pointer;
  text-shadow: none;
}

/* 图一里菜单首字母是带下划线的（File / Edit / View / Help） */
.mln-menu > button > u {
  text-decoration: underline;
  text-underline-offset: 1px;
}

.mln-menu > button:hover,
.mln-menu.mln-open > button {
  background: #b9b7e8;
  border-color: #fff #6d6b9c #6d6b9c #fff;
  color: #14143a;
}

.mln-drop {
  position: absolute;
  top: 100%;
  left: 0;
  min-width: 176px;
  padding: 2px;
  display: none;
  z-index: 20;
  background: var(--mln-win-2);
  border: 1px solid #4a4880;
  box-shadow: inset 1px 1px 0 #fff, inset -1px -1px 0 #9c9ac2, 3px 3px 0 rgba(0, 0, 0, .3);
}

.mln-menu.mln-open .mln-drop {
  display: block;
}

.mln-drop > button {
  display: flex;
  align-items: center;
  gap: 6px;
  width: 100%;
  padding: 4px 8px;
  border: 0;
  background: transparent;
  color: var(--mln-ink);
  font-family: var(--mln-face);
  font-size: 12px;
  text-align: left;
  cursor: pointer;
}

.mln-drop > button:hover {
  background: #2a4fa8;
  color: #fff;
}

.mln-drop > .mln-sep {
  height: 1px;
  margin: 3px 4px;
  background: #b7b5d6;
  box-shadow: 0 1px 0 #fff;
}

.mln-drop small {
  margin-left: auto;
  opacity: .6;
}

/* ---------------------------------------------------------------- 右侧立绘 */
.mln-portrait {
  position: absolute;
  top: 6px;
  right: 6px;
  bottom: 6px;
  width: var(--mln-portrait-w);
  z-index: 4;
  overflow: hidden;
  background:
    radial-gradient(circle at 50% 18%, #eaf4ff 0%, #bfe0f7 46%, #a9cdea 72%, #9cc4e4 100%);
  border: 1px solid #4a4880;
  box-shadow:
    inset 1px 1px 0 #fff,
    inset -1px -1px 0 #7c7aa8,
    inset 2px 2px 0 #fff,
    inset -2px -2px 0 #9a98c4;
  image-rendering: pixelated;
}

.mln-portrait::after {
  /* 像素网格，让 2D 立绘有复古 CRT 味 */
  content: '';
  position: absolute;
  inset: 0;
  pointer-events: none;
  background-image:
    repeating-linear-gradient(0deg, rgba(20, 24, 60, .10) 0 1px, transparent 1px 3px),
    repeating-linear-gradient(90deg, rgba(20, 24, 60, .07) 0 1px, transparent 1px 3px);
  mix-blend-mode: multiply;
  opacity: .55;
}

.mln-portrait-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: 50% 12%;
  image-rendering: pixelated;
  transition: filter 90ms linear;
}

/* 切动作时的"数字风格全屏变化"，用来掩盖缺帧 */
.mln-portrait-glitch {
  position: absolute;
  inset: 0;
  pointer-events: none;
  opacity: 0;
  background-image:
    repeating-linear-gradient(0deg, rgba(255, 255, 255, .9) 0 2px, transparent 2px 5px),
    repeating-linear-gradient(90deg, rgba(120, 200, 255, .55) 0 3px, transparent 3px 7px);
  mix-blend-mode: screen;
}

.mln-portrait-glitch[data-fire='1'] {
  animation: mln-glitch 170ms steps(3, end);
}

@keyframes mln-glitch {
  0% { opacity: .9; transform: translate(0, 0); }
  33% { opacity: .55; transform: translate(-3px, 2px); }
  66% { opacity: .8; transform: translate(4px, -2px); }
  100% { opacity: 0; transform: translate(0, 0); }
}

.mln-portrait-tag {
  position: absolute;
  left: 6px;
  bottom: 5px;
  padding: 1px 5px;
  background: rgba(20, 24, 60, .62);
  color: #dff1ff;
  font-family: var(--mln-face);
  font-size: 10px;
  letter-spacing: .5px;
  border: 1px solid rgba(255, 255, 255, .35);
  opacity: 0;
  transition: opacity .15s linear;
  pointer-events: none;
}

.mln-portrait:hover .mln-portrait-tag {
  opacity: 1;
}

/* 聊天页给立绘让位 */
html.mln-on .liveview {
  position: relative;
}

html.mln-on .liveview > *:not(.mln-portrait) {
  margin-right: calc(var(--mln-portrait-w) + 18px);
}

html.mln-on .liveview .liveband,
html.mln-on .liveview .live-summary {
  padding-right: 4px;
}

html.mln-on .liveview .live-summary-right {
  gap: 4px;
}

/* ------------------------------------------------------- 底部表情 / 任务栏 */
.mln-emobar {
  display: flex;
  align-items: center;
  gap: 3px;
  padding: 2px 4px;
  min-height: var(--mln-barh);
  flex: none;
  background: linear-gradient(#eae8fa, #cdcbe7);
  border: 1px solid #8f8dbb;
  box-shadow:
    inset 1px 1px 0 #fff,
    inset -1px -1px 0 #a9a7cf;
  font-family: var(--mln-face);
  user-select: none;
}

.mln-emobar[data-place='inline'] {
  margin-bottom: 6px;
}

.mln-emobar[data-place='fixed'] {
  position: fixed;
  left: 96px;
  right: 6px;
  bottom: 0;
  z-index: 30;
  border-top: 1px solid #fff;
  box-shadow:
    inset 0 1px 0 #fff,
    0 -1px 0 #4a4880;
}

/* 屏幕最底的 Windows 任务栏 */
.mln-taskbar {
  position: fixed;
  inset: auto 0 0 0;
  height: var(--mln-barh);
  z-index: 31;
  display: flex;
  align-items: center;
  gap: 3px;
  padding: 2px 3px;
  background: linear-gradient(#f2f0fd, #cdcbe7 55%, #b6b4d9);
  border-top: 1px solid #fff;
  box-shadow:
    inset 0 1px 0 #fff,
    0 -1px 0 #4a4880;
  font-family: var(--mln-face);
  font-size: 11px;
  user-select: none;
}

.mln-start {
  display: flex;
  align-items: center;
  gap: 3px;
  height: 21px;
  padding: 0 7px 0 5px;
  font-family: var(--mln-face);
  font-size: 11px;
  font-style: italic;
  font-weight: 700;
  color: #1d1d3a;
  background: linear-gradient(#fdfdff, #cccae6);
  border: 1px solid #fff;
  box-shadow: inset -1px -1px 0 #6d6b9c, inset 1px 1px 0 #fff, 0 0 0 1px #4a4880;
  cursor: pointer;
}

.mln-start:active {
  box-shadow: inset 1px 1px 0 #6d6b9c, inset -1px -1px 0 #fff, 0 0 0 1px #4a4880;
}

.mln-tasksep {
  width: 1px;
  height: 18px;
  margin: 0 2px;
  background: #8f8dbb;
  box-shadow: 1px 0 0 #fff;
}

.mln-taskbtn {
  display: flex;
  align-items: center;
  gap: 4px;
  height: 21px;
  padding: 0 7px;
  color: #1d1d3a;
  background: linear-gradient(#fdfdff, #dbd9f0);
  border: 1px solid #fff;
  box-shadow: inset -1px -1px 0 #6d6b9c, inset 1px 1px 0 #fff, 0 0 0 1px #4a4880;
}

.mln-taskbtn svg {
  width: 12px;
  height: 12px;
  shape-rendering: crispEdges;
}

.mln-taskfill {
  flex: 1;
  min-width: 0;
}

.mln-embtn {
  width: 20px;
  height: 20px;
  flex: none;
  display: grid;
  place-items: center;
  padding: 0;
  background: linear-gradient(#fdfdff, #cccae6);
  border: 1px solid #fff;
  box-shadow: inset -1px -1px 0 #6d6b9c, inset 1px 1px 0 #fff, 0 0 0 1px #4a4880;
  cursor: pointer;
}

.mln-embtn:active {
  box-shadow: inset 1px 1px 0 #6d6b9c, inset -1px -1px 0 #fff, 0 0 0 1px #4a4880;
}

.mln-embtn svg {
  width: 13px;
  height: 13px;
  shape-rendering: crispEdges;
}

.mln-emsep {
  width: 1px;
  height: 16px;
  margin: 0 2px;
  background: #8f8dbb;
  box-shadow: 1px 0 0 #fff;
}

.mln-emojis {
  display: flex;
  align-items: center;
  gap: 2px;
  overflow-x: auto;
  scrollbar-width: none;
  flex: 1;
  min-width: 0;
}

.mln-emojis::-webkit-scrollbar {
  display: none;
}

.mln-kaomoji {
  flex: none;
  padding: 1px 5px;
  border: 1px solid transparent;
  background: transparent;
  color: #26264a;
  font-family: var(--mln-face);
  font-size: 11px;
  cursor: pointer;
  white-space: nowrap;
}

.mln-kaomoji:hover {
  background: #fff;
  border-color: #8f8dbb;
}

.mln-clock {
  flex: none;
  padding: 0 6px;
  color: #1d1d3a;
  font-size: 11px;
  letter-spacing: .5px;
  border-left: 1px solid #8f8dbb;
  box-shadow: -1px 0 0 #fff;
}

/* 窗口最大化 / 最小化 */
html.mln-max #kernel-root {
  margin: 0;
  border: 0;
  box-shadow: none;
}

html.mln-min #kernel-root > div:not(.mln-chrome),
html.mln-min #kernel-root > *:not(.mln-chrome) {
  display: none;
}

/* ---------------------------------------------------------- 面板（设置页） */
.mln-panel {
  display: grid;
  gap: 10px;
  padding: 8px;
  font-family: var(--mln-face);
  font-size: 12px;
  color: var(--mln-ink);
  background: var(--mln-win-2);
  border: 1px solid #4a4880;
  box-shadow: inset 1px 1px 0 #fff, inset -1px -1px 0 #9c9ac2;
}

.mln-panel h3 {
  margin: 0;
  padding: 2px 4px;
  font-size: 12px;
  background: linear-gradient(180deg, #a7a5e6, #8f8dd8);
  color: #fff;
  text-shadow: 1px 1px 0 rgba(20, 20, 60, .7);
}

.mln-panel-row {
  display: grid;
  grid-template-columns: 92px 1fr;
  align-items: start;
  gap: 6px;
}

.mln-panel-row > span {
  color: var(--mln-ink-soft);
  padding-top: 3px;
}

.mln-panel input[type='text'],
.mln-panel input[type='number'],
.mln-panel textarea {
  width: 100%;
  padding: 3px 5px;
  font-family: var(--mln-face);
  font-size: 12px;
  color: var(--mln-ink);
  background: #fff;
  border: 1px solid #8f8dbb;
  box-shadow: inset 1px 1px 0 #d6d4ea;
}

.mln-panel textarea {
  min-height: 48px;
  resize: vertical;
}

.mln-panel button {
  padding: 3px 10px;
  font-family: var(--mln-face);
  font-size: 12px;
  color: #1d1d3a;
  background: linear-gradient(#fdfdff, #cccae6);
  border: 1px solid #fff;
  box-shadow: inset -1px -1px 0 #6d6b9c, inset 1px 1px 0 #fff, 0 0 0 1px #4a4880;
  cursor: pointer;
}

.mln-panel button:active {
  box-shadow: inset 1px 1px 0 #6d6b9c, inset -1px -1px 0 #fff, 0 0 0 1px #4a4880;
}

.mln-panel-actions {
  display: flex;
  gap: 6px;
  align-items: center;
  flex-wrap: wrap;
}

.mln-panel-hint {
  color: var(--mln-ink-soft);
  font-size: 11px;
  line-height: 1.5;
}

.mln-face-list {
  display: grid;
  gap: 6px;
}

.mln-face-item {
  display: grid;
  grid-template-columns: 76px 1fr;
  gap: 6px;
  align-items: start;
  padding: 5px;
  background: #f5f4ff;
  border: 1px solid #c4c2e0;
}

.mln-face-item img {
  width: 72px;
  height: 86px;
  object-fit: cover;
  image-rendering: pixelated;
  border: 1px solid #8f8dbb;
}

.mln-panel-toggle {
  display: flex;
  align-items: center;
  gap: 6px;
}

@media (max-width: 1080px) {
  html.mln-on {
    --mln-portrait-w: 240px;
  }
}

@media (max-width: 820px) {
  html.mln-on .mln-portrait {
    display: none;
  }

  html.mln-on .liveview > *:not(.mln-portrait) {
    margin-right: 0;
  }
}

/* ------------------------------------------------------------ 字号微调 */
/* 破晓像素是 12px 点阵设计的，字面比同字号的黑体小一号；整体抬到 13px 更像图一那行字 */
html.mln-on #kernel-root { font-size: 13px; }
html.mln-on .mln-titlebar { font-size: 13px; }
html.mln-on .mln-menubar .mln-menu > button { font-size: 13px; }
html.mln-on #rail .stack > * { font-size: 12px; }
html.mln-on #rail .rail-name,
html.mln-on #rail .rail-runstate { font-size: 12px; }
html.mln-on .mln-kaomoji { font-size: 12px; }
html.mln-on .mln-panel { font-size: 13px; }
html.mln-on .mln-panel-hint { font-size: 12px; }
