{
  "name": "elymes-nte-web",
  "version": "0.2.1",
  "description": "和Y？聊天（曳尔沐对话）网页端插件：把聊天做成 QQ2007 / Windows 98 复古窗口与千禧风 CRT 窗口，右侧像素立绘伪插帧、表情随关键词切换，另带一只透明桌宠；包里附开发中遇到的问题.md，界面里还藏着一个和数字、正文原文有关的彩蛋。",
  "type": "module",
  "main": "./src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist",
    "assets",
    "tools/build.mjs",
    "tools/webui.source.js",
    "tools/window-server.mjs",
    "tools/win-frame.ps1",
    "tools/nt-top.ps1",
    "tools/window",
    "README.md",
    "LICENSE",
    "开发中遇到的问题.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "coopanion",
    "cortico",
    "cortico-world",
    "chat-ui",
    "retro",
    "qq2007",
    "windows98",
    "pixel-art",
    "desktop-pet",
    "elymes"
  ],
  "author": "曳尔沐",
  "license": "MIT",
  "dependencies": {
    "ws": "^8.22.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BaiLin-bit/elymes-nte-web.git"
  },
  "bugs": {
    "url": "https://github.com/BaiLin-bit/elymes-nte-web/issues"
  },
  "homepage": "https://github.com/BaiLin-bit/elymes-nte-web#readme",
  "cortico": {
    "kind": "world",
    "api": 6,
    "displayName": "和Y？聊天",
    "webUiClient": "dist/webui.js",
    "webUiStyle": "dist/webui.css"
  }
}
